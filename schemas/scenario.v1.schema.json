{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skyblip.eu/schemas/scenario.v1.schema.json",
  "title": "skyBlip simulator scenario (v1)",
  "description": "One scenario drives the browser simulator, the terminal simulator and the host regression suite. Parsed and replayed by firmware/simulator/world.",
  "type": "object",
  "properties": {
    "name": {"type": "string"},
    "mode": {"enum": ["dev", "demo", "training"]},
    "lat_1e7": {"type": "integer"},
    "lon_1e7": {"type": "integer"},
    "alt_m": {"type": "integer"},
    "speed_kt": {"type": "integer", "minimum": 0},
    "track_deg": {"type": "integer", "minimum": 0, "maximum": 359},
    "turn_dps": {"type": "integer", "minimum": -50, "maximum": 50, "description": "Own-ship turn rate, degrees per second, positive to the right. A thermalling glider holds 13 to 18."},
    "duration_ms": {"type": "integer", "minimum": 0},
    "aircraft": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": {"type": "string", "enum": ["adsl", "alptas", "uplink"], "description": "What reaches us from this aircraft: its own ADS-L or FLARM-generation burst on the M band, or a skyPost ground station's O-band relay of it, which is what 'uplink' means. An 'uplink' aircraft never transmits itself."},
          "north_m": {"type": "integer"},
          "east_m": {"type": "integer"},
          "up_m": {"type": "integer"},
          "speed_mps": {"type": "integer", "minimum": 0},
          "track_deg": {"type": "integer", "minimum": 0, "maximum": 359},
          "turn_dps": {"type": "integer", "minimum": -50, "maximum": 50, "description": "Turn rate of this aircraft, degrees per second, positive to the right."},
          "phase_ms": {"type": "integer", "minimum": -1, "maximum": 999},
          "slot": {"type": "integer", "minimum": -1, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_ms": {"type": "integer", "minimum": 0},
          "fix": {"type": "integer", "enum": [0, 1]},
          "pps": {"type": "integer", "enum": [0, 1]},
          "baro": {"type": "integer", "enum": [0, 1]},
          "battery_mv": {"type": "integer", "minimum": 0, "maximum": 5000},
          "external_power": {"type": "integer", "enum": [0, 1]},
          "button": {"type": "integer"},
          "altitude_m": {"type": "integer"},
          "speed_kt": {"type": "integer", "minimum": 0},
          "track_deg": {"type": "integer"},
          "aircraft": {"type": "integer"},
          "expect_alarm_min": {"type": "integer", "minimum": 0, "maximum": 3},
          "expect_traffic_min": {"type": "integer", "minimum": 0}
        },
        "required": ["at_ms"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
