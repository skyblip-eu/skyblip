{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skyblip.eu/schemas/config.v1.schema.json",
  "title": "skyBlip device configuration (v1)",
  "description": "JSON config exchanged over the dedicated GATT characteristic / USB-CDC (decisions/config.md §3). The producer (firmware) owns this schema (decisions/repos.md §2); consumers pin a version.",
  "type": "object",
  "properties": {
    "version": {"type": "integer", "const": 1},
    "addr": {"type": "integer", "minimum": 0, "maximum": 16777215,
             "description": "24-bit device address, auto-derived from chip id"},
    "addr_table": {"type": "integer", "minimum": 0, "maximum": 63,
                   "description": "0=random,5=ICAO,6=FLARM (ALP-TAS)"},
    "aircraft_type": {"type": "integer", "minimum": 0, "maximum": 17,
                      "description": "ADS-L aircraft category"},
    "region": {"type": "integer", "minimum": 0, "description": "0=auto(GPS)"},
    "alarm": {"type": "boolean"},
    "alarm_volume": {"type": "integer", "minimum": 0, "maximum": 5},
    "stealth": {"type": "boolean"},
    "units": {"type": "integer", "enum": [0, 1], "description": "0=metric,1=imperial"},
    "rotation": {"type": "integer", "minimum": 0, "maximum": 3},
    "page_mask": {"type": "integer", "minimum": 0, "maximum": 255},
    "power_save": {"type": "boolean"},
    "callsign": {"type": "string", "maxLength": 9}
  },
  "required": ["version"],
  "additionalProperties": true
}
