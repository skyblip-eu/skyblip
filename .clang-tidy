# skyBlip firmware clang-tidy config: the C++ subset rules (1-ARCHITECTURE §4),
# no heap after init, no owning raw new/delete, readable names.
# TODO: fc 24aug26 no job runs this, so the rules it names are not enforced anywhere
Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -readability-function-cognitive-complexity

WarningsAsErrors: 'cppcoreguidelines-no-malloc,cppcoreguidelines-owning-memory'
HeaderFilterRegex: '(core|ui|hal|hardware|boards)/.*'
FormatStyle: file
