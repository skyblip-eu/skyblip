CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_CLOCK_CONTROL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
# nRF52840 uses the internal RC/xtal LF clock for the BT stack + kernel tick.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

# The SoC's own REG1 DC-DC converter instead of its LDO. This is a statement
# about the board and not about the product: enabling it needs the inductor on
# DCC/DEC4 to be fitted, and an nRF52840 switched to DC-DC without one does not
# regulate. The evidence that it is fitted is meshcore's shipped firmware for
# this exact board - variants/lilygo_techo/TechoBoard.h:16 derives TechoBoard
# from NRF52BoardDCDC, whose begin() writes NRF_POWER->DCDCEN = 1
# (src/helpers/NRF52Board.cpp:227-238). The T-Echo schematic is NOT in
# project/reference/, so this is a second-source claim and the bench measurement
# is what closes it.
CONFIG_BOARD_ENABLE_DCDC=y

# Link into the `zephyr,code-partition` chosen in the board devicetree rather
# than at flash base 0. Without this, CONFIG_FLASH_LOAD_OFFSET defaults to 0
# (Kconfig.zephyr:133) and both the ELF and the generated .uf2 target 0x0:
# which would overwrite the factory MBR + SoftDevice. The upstream promicro_
# nrf52840 uf2 variant sets this explicitly for the same reason; the Adafruit
# feather uf2 variant forgets to, and is wrong.
CONFIG_USE_DT_CODE_PARTITION=y

# CONFIG_BUILD_OUTPUT_UF2 is deliberately NOT set, even though the T-Echo's
# install path is a .uf2. It would convert the UNSIGNED zephyr.bin, producing a
# build/firmware/zephyr/zephyr.uf2 that looks like the artifact to flash and that
# MCUboot will refuse to boot. scripts/mkuf2.py is the single source of the real
# .uf2: it merges the bootloader and the signed, confirmed application and range-
# checks the result against the factory bootloader's write window.
